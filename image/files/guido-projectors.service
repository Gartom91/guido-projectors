[Unit]
Description=Guido Dell/Casio projector controller
After=network.target guido-firstboot.service
ConditionPathExists=/etc/guido-projectors/config.json
ConditionPathExists=/etc/guido-projectors/server.key
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=guido-projectors
DynamicUser=yes
SupplementaryGroups=dialout
ExecStart=/usr/bin/python3 /opt/guido-projectors/guido.py serve
Restart=on-failure
RestartSec=5
TimeoutStopSec=150
RuntimeDirectory=guido-projectors
RuntimeDirectoryMode=0700
StateDirectory=guido-projectors
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
